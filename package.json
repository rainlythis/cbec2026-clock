{
  "name": "topthai-day-business-matching-live",
  "version": "1.0.0",
  "private": true,
  "description": "TOPTHAI Day Business Matching Live - realtime room display, public mobile view and operator control",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/cli/migrate-cli.ts",
    "migrate:prod": "node dist/cli/migrate-cli.js",
    "seed": "tsx src/cli/seed-cli.ts",
    "seed:prod": "node dist/cli/seed-cli.js",
    "test": "npm run build && node --test \"dist/__tests__/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import:xlsx": "tsx src/cli/import-xlsx-cli.ts",
    "import:xlsx:prod": "node dist/cli/import-xlsx-cli.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
