# ---------------------------------------------------------------------------
# TOPTHAI Day Business Matching Live - environment variables
# Copy to .env for local development. On Railway set these in the service
# "Variables" tab instead (never commit real values).
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# On Railway: add a PostgreSQL database and reference ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/topthai_matching

# Single operator passcode that unlocks /control.
# Use a long random value. Never hard-code it in the frontend or a URL.
CONTROL_PASSWORD=change-me-to-a-long-random-passcode

# Secret used to sign the operator session cookie (HMAC-SHA256).
# Keep it stable across deploys or every operator session is invalidated.
SESSION_SECRET=change-me-to-a-long-random-secret

# Public origin of the deployment. Used to build the QR code shown on /display.
# On Railway: https://<your-service>.up.railway.app
PUBLIC_BASE_URL=http://localhost:8080

# Event timezone. Everything user-facing is rendered in Asia/Bangkok.
TZ=Asia/Bangkok

# HTTP port. Railway injects this automatically; 8080 is the local default.
PORT=8080

# Optional. Set to "false" to keep secure cookies off behind a plain-HTTP
# reverse proxy. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# Optional. Operator session lifetime in hours (default 12).
# SESSION_TTL_HOURS=12
